# Server
PORT=3001
# Public URL used for canonical links, sitemap and Open Graph
# localhost while the site is in development, replace with the public domain
# when the site goes live
SITE_URL=http://localhost:3001
# Browser origins allowed to call the API, comma separated
CLIENT_ORIGIN=http://localhost:5173

# MySQL (MySQL Workbench uses the same values)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petali_e_fiori
DB_USER=root
DB_PASSWORD=

# Optional: full path to the mysql client binary used by `npm run seed`.
# Leave empty to search PATH and the common install locations.
MYSQL_BIN=

# Contact form
CONTACT_RATE_LIMIT=10
